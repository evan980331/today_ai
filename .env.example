# Server 設定 (Render 會自動注入 PORT=10000)
PORT=3001
NODE_ENV=production
MCP_TIMEOUT_MS=60000

# OpenCode runtime (三選一，由 getRuntimeMode() 判定):
#   1. local-cli     - 本機有 `opencode` binary，直接 spawn (dev/local 預設)
#   2. remote-server - 外部 OpenCode Server / Agent Worker (production 目標)
#   3. unavailable   - production 無可用 runtime，API 明確回 503，不假裝成功
# Render 不會自動啟動 OpenCode Server，localhost:4096 在雲端不存在。
#
# 連線合約：Today AI API → OPENCODE_SERVER_URL → OpenCode Agent Worker
#   - Worker 必須是 Linux 主機，安裝 OpenCode CLI (>= 1.18, 驗證過 1.18.30)
#   - Worker 以 `opencode serve --port 4096 --hostname 127.0.0.1` 運行
#     (或經由內網/Tailscale 可達的地址)，Today AI 只存 URL，不代管 Worker
#   - Worker 需要：git, node/npm, isolated workspace 目錄, GitHub 連線,
#     適當的 CPU/記憶體/並行上限 (Today AI 只保證單 session 單執行，
#     Worker 端仍需自己的並行與資源限制)
#   - 認證：HTTP Basic (USERNAME/PASSWORD)，password 絕對不能寫入 repo
#   - 已驗證 endpoint：POST /session, POST /session/{id}/message,
#     GET /event (SSE), POST /session/{id}/abort (見 docs/cloud-architecture.md)
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# 選填：連接真正 OpenCode Server 的整合測試開關 (預設關閉=SKIP，不假裝通過)
# OPENCODE_INTEGRATION_TEST=true

# ── Vercel (API / Web / Auth / Orchestrator) ──────────────────
# Vercel 只跑 API 與前端，不 spawn OpenCode。缺 WORKER_URL 即 503。
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.../neondb?sslmode=require
# ALLOWED_ORIGINS=https://today-ai.example.com
# WORKER_URL=https://your-worker.example.com  # Cloudflare Tunnel 公開 HTTPS origin（只要 origin，不加 /health 或任何路徑）
# WORKER_SHARED_SECRET=replace-with-generated-secret  # 與 Laptop Worker 相同，Vercel 與 Worker 皆需設定

# ── Laptop Worker (Remote Worker / OpenCode 主機, Windows) ───────
# 筆電只綁 localhost，靠 Cloudflare Tunnel 對外。不要把 4096 暴露到 Internet。
# WORKER_SHARED_SECRET=                    # 必填，與 Vercel 相同
# WORKSPACE_ROOT=D:\todayai-workspaces     # 筆電本地隔離目錄，每 workspace/session 獨立
# OPENCODE_PATH=                            # 選填，Windows 若 PATH 找不到 opencode 時指定完整路徑
# WORKER_HOST=127.0.0.1                      # 固定 localhost
# WORKER_PORT=4100
# OPENCODE_SERVER_PASSWORD=                  # 選填，若 OpenCode 另需密碼（Worker 內部）
# ────────────────────────────────────────────────────────────────
WORKSPACE_ROOT=
WORKER_START_TIMEOUT_MS=30000
AGENT_EXECUTION_TIMEOUT_MS=600000
# 失敗現場保留 (true=失敗時不刪除 workspace 目錄，預設 false=永遠清理)
# WORKSPACE_KEEP_ON_FAILURE=true
# 資源上限 (MAX_WORKERS 會強制執行；SIZE 目前僅合約宣告，未強制)
# MAX_WORKERS=4
# MAX_WORKSPACE_SIZE_MB=512
# 遠端 Worker 通用（origin only，不加 /health 或路徑）：
# WORKER_URL=https://your-worker.example.com
# WORKER_SHARED_SECRET=replace-with-generated-secret
# 遠端請求預設超時 (ms；Today AI API 呼叫 Worker 用，stream 另有 AGENT_EXECUTION_TIMEOUT_MS 上限)：
# WORKER_REQUEST_TIMEOUT_MS=15000
# 雲端 E2E 合約測試開關 (需 TODAY_AI_BASE_URL + WORKER_URL + SECRET，同時具備才跑)
# CLOUD_WORKER_INTEGRATION_TEST=true
# TODAY_AI_BASE_URL=https://today.example.com
# E2E_USERNAME=
# E2E_PASSWORD=
# MOCK 僅 dev/test 可用；production 設定 true 會直接啟動失敗
MOCK_OPENCODE=false

# Auth - 帳號密碼已遷移至 Neon auth_users (hashed)
# 初始化一次性: AUTH_USERNAME / AUTH_PASSWORD 僅用於 `npm run auth:setup` 寫入 DB
#   npm run auth:setup  # 需 DATABASE_URL + AUTH_USERNAME + AUTH_PASSWORD
# 之後登入改查 auth_users，不再依賴 env 常駐
# AUTH_USERNAME=
# AUTH_PASSWORD=
ALLOWED_ORIGINS=https://today-ai.example.com  # production 必填 (Vercel)

# Database - Neon Postgres (serverless) [必填]
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub 設定 (選填)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# Google OAuth 設定 (Calendar & Gmail) (選填)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
