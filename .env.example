# Server 設定 (Render 會自動注入 PORT=10000)
PORT=3001
NODE_ENV=production
MCP_TIMEOUT_MS=60000

# Database - Neon Postgres (serverless) [必填]
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub 設定
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here

# Google OAuth 設定 (Calendar & Gmail)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
